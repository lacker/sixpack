theorem grid_ancestry_row1_checked :
    ∀ j : Fin 32, ∀ down : Bool, ∀ hv : ValidGridCell 32 1 j.val down,
      let w := gridAncestryRow1.getD (2*j.val + if down then 1 else 0) (0,0,0,0)
