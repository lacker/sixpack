theorem b31_row_group56_coverage_accepted :
    checkIndexedRectangleCoverage b31RowGroup56Blocks b31RowGroup56Group b31RowGroup56Blockers b31RowGroup56OwnerSelect b31RowGroup56OtherSelect = true := by
  simp only [checkIndexedRectangleCoverage,Bool.and_eq_true,decide_eq_true_eq]
  refine ⟨?_,b31RowGroup56_other_all⟩
  intro block part
  let flat : Fin 51 := ⟨block.val*1+part.val,by
    have hb := block.isLt; have hp := part.isLt; omega⟩
  have hb : b31RowGroup56OwnerBlock flat = block := by
    apply Fin.ext
    dsimp [b31RowGroup56OwnerBlock,flat]
    have hp := part.isLt
    omega
  have hp : b31RowGroup56OwnerPart flat = part := by
    apply Fin.ext
    dsimp [b31RowGroup56OwnerPart,flat]
    have hp := part.isLt
    omega
  have h := b31RowGroup56_owner_all flat
  rw [hb,hp] at h
  exact h

