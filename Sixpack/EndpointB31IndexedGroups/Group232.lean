  refine ⟨?_,b31RowGroup232_other_all⟩
  intro block part
  let flat : Fin 51 := ⟨block.val*1+part.val,by
    have hb := block.isLt; have hp := part.isLt; omega⟩
  have hb : b31RowGroup232OwnerBlock flat = block := by
    apply Fin.ext
    dsimp [b31RowGroup232OwnerBlock,flat]
    have hp := part.isLt
    omega
  have hp : b31RowGroup232OwnerPart flat = part := by
    apply Fin.ext
    dsimp [b31RowGroup232OwnerPart,flat]
    have hp := part.isLt
    omega
  have h := b31RowGroup232_owner_all flat
  rw [hb,hp] at h
  exact h

