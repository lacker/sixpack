  refine ⟨?_,b31RowGroup361_other_all⟩
  intro block part
  let flat : Fin 72 := ⟨block.val*2+part.val,by
    have hb := block.isLt; have hp := part.isLt; omega⟩
  have hb : b31RowGroup361OwnerBlock flat = block := by
