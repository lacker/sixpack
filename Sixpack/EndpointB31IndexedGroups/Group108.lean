  refine ⟨?_,b31RowGroup108_other_all⟩
  intro block part
  let flat : Fin 44 := ⟨block.val*1+part.val,by
    have hb := block.isLt; have hp := part.isLt; omega⟩
  have hb : b31RowGroup108OwnerBlock flat = block := by
    apply Fin.ext
    dsimp [b31RowGroup108OwnerBlock,flat]
    have hp := part.isLt
    omega
  have hp : b31RowGroup108OwnerPart flat = part := by
    apply Fin.ext
    dsimp [b31RowGroup108OwnerPart,flat]
    have hp := part.isLt
    omega
  have h := b31RowGroup108_owner_all flat
  rw [hb,hp] at h
  exact h

