theorem b31_row_group406_coverage_accepted :
    checkIndexedRectangleCoverage b31RowGroup406Blocks b31RowGroup406Group b31RowGroup406Blockers b31RowGroup406OwnerSelect b31RowGroup406OtherSelect = true := by
