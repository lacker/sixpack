  refine ⟨?_,b31RowGroup406_other_all⟩
  intro block part
  let flat : Fin 96 := ⟨block.val*4+part.val,by
    have hb := block.isLt; have hp := part.isLt; omega⟩
  have hb : b31RowGroup406OwnerBlock flat = block := by
    apply Fin.ext
    dsimp [b31RowGroup406OwnerBlock,flat]
    have hp := part.isLt
    omega
  have hp : b31RowGroup406OwnerPart flat = part := by
    apply Fin.ext
    dsimp [b31RowGroup406OwnerPart,flat]
    have hp := part.isLt
    omega
  have h := b31RowGroup406_owner_all flat
  rw [hb,hp] at h
  exact h

