  refine ⟨?_,b31RowGroup415_other_all⟩
  intro block part
  let flat : Fin 50 := ⟨block.val*2+part.val,by
    have hb := block.isLt; have hp := part.isLt; omega⟩
  have hb : b31RowGroup415OwnerBlock flat = block := by
    apply Fin.ext
    dsimp [b31RowGroup415OwnerBlock,flat]
    have hp := part.isLt
    omega
  have hp : b31RowGroup415OwnerPart flat = part := by
    apply Fin.ext
    dsimp [b31RowGroup415OwnerPart,flat]
    have hp := part.isLt
    omega
  have h := b31RowGroup415_owner_all flat
  rw [hb,hp] at h
  exact h

