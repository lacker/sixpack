theorem b31_row_group125_coverage_accepted :
    checkIndexedRectangleCoverage b31RowGroup125Blocks b31RowGroup125Group b31RowGroup125Blockers b31RowGroup125OwnerSelect b31RowGroup125OtherSelect = true := by
  simp only [checkIndexedRectangleCoverage,Bool.and_eq_true,decide_eq_true_eq]
  refine ⟨?_,b31RowGroup125_other_all⟩
  intro block part
  let flat : Fin 46 := ⟨block.val*1+part.val,by
    have hb := block.isLt; have hp := part.isLt; omega⟩
  have hb : b31RowGroup125OwnerBlock flat = block := by
    apply Fin.ext
    dsimp [b31RowGroup125OwnerBlock,flat]
    have hp := part.isLt
    omega
  have hp : b31RowGroup125OwnerPart flat = part := by
    apply Fin.ext
    dsimp [b31RowGroup125OwnerPart,flat]
    have hp := part.isLt
    omega
  have h := b31RowGroup125_owner_all flat
  rw [hb,hp] at h
  exact h

