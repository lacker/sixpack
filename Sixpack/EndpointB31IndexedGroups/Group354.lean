theorem b31_row_group354_coverage_accepted :
    checkIndexedRectangleCoverage b31RowGroup354Blocks b31RowGroup354Group b31RowGroup354Blockers b31RowGroup354OwnerSelect b31RowGroup354OtherSelect = true := by
  simp only [checkIndexedRectangleCoverage,Bool.and_eq_true,decide_eq_true_eq]
  refine ⟨?_,b31RowGroup354_other_all⟩
  intro block part
  let flat : Fin 32 := ⟨block.val*1+part.val,by
    have hb := block.isLt; have hp := part.isLt; omega⟩
  have hb : b31RowGroup354OwnerBlock flat = block := by
    apply Fin.ext
    dsimp [b31RowGroup354OwnerBlock,flat]
    have hp := part.isLt
    omega
  have hp : b31RowGroup354OwnerPart flat = part := by
    apply Fin.ext
    dsimp [b31RowGroup354OwnerPart,flat]
    have hp := part.isLt
    omega
  have h := b31RowGroup354_owner_all flat
  rw [hb,hp] at h
  exact h

