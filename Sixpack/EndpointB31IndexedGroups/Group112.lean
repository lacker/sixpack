  refine ⟨?_,b31RowGroup112_other_all⟩
  intro block part
  let flat : Fin 88 := ⟨block.val*2+part.val,by
    have hb := block.isLt; have hp := part.isLt; omega⟩
  have hb : b31RowGroup112OwnerBlock flat = block := by
    apply Fin.ext
    dsimp [b31RowGroup112OwnerBlock,flat]
    have hp := part.isLt
    omega
  have hp : b31RowGroup112OwnerPart flat = part := by
    apply Fin.ext
    dsimp [b31RowGroup112OwnerPart,flat]
    have hp := part.isLt
    omega
  have h := b31RowGroup112_owner_all flat
  rw [hb,hp] at h
  exact h

