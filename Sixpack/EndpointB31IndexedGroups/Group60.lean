private theorem b31RowGroup60_other_all (part : Fin 346) :
    b31RowGroup60Blockers part = (b31RowGroup60Blocks (b31RowGroup60OtherSelect part).1).other (b31RowGroup60OtherSelect part).2 := by
  let batch : Fin 11 := ⟨part.val/32,by have h := part.isLt; omega⟩
  let offset : Fin 32 := ⟨part.val%32,Nat.mod_lt _ (by decide)⟩
  have hi : b31RowGroup60OtherBatchIndex batch offset = part := by
    apply Fin.ext
    change (32*(part.val/32)+part.val%32)%346 = part.val
    rw [Nat.div_add_mod,Nat.mod_eq_of_lt part.isLt]
  rw [← hi]
  exact b31RowGroup60_other_batches batch offset

theorem b31_row_group60_coverage_accepted :
    checkIndexedRectangleCoverage b31RowGroup60Blocks b31RowGroup60Group b31RowGroup60Blockers b31RowGroup60OwnerSelect b31RowGroup60OtherSelect = true := by
  simp only [checkIndexedRectangleCoverage,Bool.and_eq_true,decide_eq_true_eq]
  refine ⟨?_,b31RowGroup60_other_all⟩
  intro block part
  let flat : Fin 74 := ⟨block.val*2+part.val,by
    have hb := block.isLt; have hp := part.isLt; omega⟩
  have hb : b31RowGroup60OwnerBlock flat = block := by
    apply Fin.ext
    dsimp [b31RowGroup60OwnerBlock,flat]
    have hp := part.isLt
    omega
  have hp : b31RowGroup60OwnerPart flat = part := by
    apply Fin.ext
    dsimp [b31RowGroup60OwnerPart,flat]
    have hp := part.isLt
    omega
  have h := b31RowGroup60_owner_all flat
  rw [hb,hp] at h
  exact h

