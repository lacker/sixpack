theorem b31_row_group68_coverage_accepted :
    checkIndexedRectangleCoverage b31RowGroup68Blocks b31RowGroup68Group b31RowGroup68Blockers b31RowGroup68OwnerSelect b31RowGroup68OtherSelect = true := by
  simp only [checkIndexedRectangleCoverage,Bool.and_eq_true,decide_eq_true_eq]
  refine ⟨?_,b31RowGroup68_other_all⟩
  intro block part
  let flat : Fin 47 := ⟨block.val*1+part.val,by
    have hb := block.isLt; have hp := part.isLt; omega⟩
  have hb : b31RowGroup68OwnerBlock flat = block := by
    apply Fin.ext
    dsimp [b31RowGroup68OwnerBlock,flat]
    have hp := part.isLt
    omega
  have hp : b31RowGroup68OwnerPart flat = part := by
    apply Fin.ext
    dsimp [b31RowGroup68OwnerPart,flat]
    have hp := part.isLt
    omega
  have h := b31RowGroup68_owner_all flat
  rw [hb,hp] at h
  exact h

