  refine ⟨?_,b31RowGroup42_other_all⟩
  intro block part
  let flat : Fin 88 := ⟨block.val*2+part.val,by
    have hb := block.isLt; have hp := part.isLt; omega⟩
  have hb : b31RowGroup42OwnerBlock flat = block := by
    apply Fin.ext
    dsimp [b31RowGroup42OwnerBlock,flat]
    have hp := part.isLt
    omega
  have hp : b31RowGroup42OwnerPart flat = part := by
    apply Fin.ext
    dsimp [b31RowGroup42OwnerPart,flat]
    have hp := part.isLt
    omega
  have h := b31RowGroup42_owner_all flat
  rw [hb,hp] at h
  exact h

