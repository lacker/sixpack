  refine ⟨?_,b31RowGroup300_other_all⟩
  intro block part
  let flat : Fin 54 := ⟨block.val*1+part.val,by
    have hb := block.isLt; have hp := part.isLt; omega⟩
  have hb : b31RowGroup300OwnerBlock flat = block := by
    apply Fin.ext
    dsimp [b31RowGroup300OwnerBlock,flat]
    have hp := part.isLt
    omega
  have hp : b31RowGroup300OwnerPart flat = part := by
    apply Fin.ext
    dsimp [b31RowGroup300OwnerPart,flat]
