private theorem b31RowGroup99_other_all (part : Fin 346) :
    b31RowGroup99Blockers part = (b31RowGroup99Blocks (b31RowGroup99OtherSelect part).1).other (b31RowGroup99OtherSelect part).2 := by
  let batch : Fin 11 := ⟨part.val/32,by have h := part.isLt; omega⟩
  let offset : Fin 32 := ⟨part.val%32,Nat.mod_lt _ (by decide)⟩
  have hi : b31RowGroup99OtherBatchIndex batch offset = part := by
    apply Fin.ext
    change (32*(part.val/32)+part.val%32)%346 = part.val
    rw [Nat.div_add_mod,Nat.mod_eq_of_lt part.isLt]
  rw [← hi]
  exact b31RowGroup99_other_batches batch offset

theorem b31_row_group99_coverage_accepted :
    checkIndexedRectangleCoverage b31RowGroup99Blocks b31RowGroup99Group b31RowGroup99Blockers b31RowGroup99OwnerSelect b31RowGroup99OtherSelect = true := by
  simp only [checkIndexedRectangleCoverage,Bool.and_eq_true,decide_eq_true_eq]
  refine ⟨?_,b31RowGroup99_other_all⟩
  intro block part
  let flat : Fin 74 := ⟨block.val*2+part.val,by
    have hb := block.isLt; have hp := part.isLt; omega⟩
  have hb : b31RowGroup99OwnerBlock flat = block := by
    apply Fin.ext
    dsimp [b31RowGroup99OwnerBlock,flat]
    have hp := part.isLt
    omega
  have hp : b31RowGroup99OwnerPart flat = part := by
    apply Fin.ext
    dsimp [b31RowGroup99OwnerPart,flat]
    have hp := part.isLt
    omega
  have h := b31RowGroup99_owner_all flat
  rw [hb,hp] at h
  exact h

