theorem b31_row_group51_coverage_accepted :
    checkIndexedRectangleCoverage b31RowGroup51Blocks b31RowGroup51Group b31RowGroup51Blockers b31RowGroup51OwnerSelect b31RowGroup51OtherSelect = true := by
  simp only [checkIndexedRectangleCoverage,Bool.and_eq_true,decide_eq_true_eq]
  refine ⟨?_,b31RowGroup51_other_all⟩
  intro block part
  let flat : Fin 61 := ⟨block.val*1+part.val,by
    have hb := block.isLt; have hp := part.isLt; omega⟩
  have hb : b31RowGroup51OwnerBlock flat = block := by
    apply Fin.ext
    dsimp [b31RowGroup51OwnerBlock,flat]
    have hp := part.isLt
    omega
  have hp : b31RowGroup51OwnerPart flat = part := by
    apply Fin.ext
    dsimp [b31RowGroup51OwnerPart,flat]
    have hp := part.isLt
    omega
  have h := b31RowGroup51_owner_all flat
  rw [hb,hp] at h
  exact h

