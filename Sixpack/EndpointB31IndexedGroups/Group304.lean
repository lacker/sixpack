    rw [Nat.div_add_mod,Nat.mod_eq_of_lt part.isLt]
  rw [← hi]
  exact b31RowGroup304_other_batches batch offset

theorem b31_row_group304_coverage_accepted :
    checkIndexedRectangleCoverage b31RowGroup304Blocks b31RowGroup304Group b31RowGroup304Blockers b31RowGroup304OwnerSelect b31RowGroup304OtherSelect = true := by
  simp only [checkIndexedRectangleCoverage,Bool.and_eq_true,decide_eq_true_eq]
  refine ⟨?_,b31RowGroup304_other_all⟩
  intro block part
  let flat : Fin 74 := ⟨block.val*1+part.val,by
    have hb := block.isLt; have hp := part.isLt; omega⟩
  have hb : b31RowGroup304OwnerBlock flat = block := by
    apply Fin.ext
    dsimp [b31RowGroup304OwnerBlock,flat]
    have hp := part.isLt
    omega
  have hp : b31RowGroup304OwnerPart flat = part := by
    apply Fin.ext
    dsimp [b31RowGroup304OwnerPart,flat]
    have hp := part.isLt
    omega
  have h := b31RowGroup304_owner_all flat
  rw [hb,hp] at h
  exact h

