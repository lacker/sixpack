  refine ⟨?_,b31RowGroup360_other_all⟩
  intro block part
  let flat : Fin 72 := ⟨block.val*2+part.val,by
    have hb := block.isLt; have hp := part.isLt; omega⟩
  have hb : b31RowGroup360OwnerBlock flat = block := by
    apply Fin.ext
    dsimp [b31RowGroup360OwnerBlock,flat]
    have hp := part.isLt
    omega
  have hp : b31RowGroup360OwnerPart flat = part := by
    apply Fin.ext
    dsimp [b31RowGroup360OwnerPart,flat]
    have hp := part.isLt
    omega
  have h := b31RowGroup360_owner_all flat
  rw [hb,hp] at h
  exact h

