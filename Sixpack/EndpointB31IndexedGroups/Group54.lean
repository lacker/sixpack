theorem b31_row_group54_coverage_accepted :
    checkIndexedRectangleCoverage b31RowGroup54Blocks b31RowGroup54Group b31RowGroup54Blockers b31RowGroup54OwnerSelect b31RowGroup54OtherSelect = true := by
  simp only [checkIndexedRectangleCoverage,Bool.and_eq_true,decide_eq_true_eq]
  refine ⟨?_,b31RowGroup54_other_all⟩
  intro block part
  let flat : Fin 47 := ⟨block.val*1+part.val,by
    have hb := block.isLt; have hp := part.isLt; omega⟩
  have hb : b31RowGroup54OwnerBlock flat = block := by
    apply Fin.ext
    dsimp [b31RowGroup54OwnerBlock,flat]
    have hp := part.isLt
    omega
  have hp : b31RowGroup54OwnerPart flat = part := by
    apply Fin.ext
    dsimp [b31RowGroup54OwnerPart,flat]
    have hp := part.isLt
    omega
  have h := b31RowGroup54_owner_all flat
  rw [hb,hp] at h
  exact h

