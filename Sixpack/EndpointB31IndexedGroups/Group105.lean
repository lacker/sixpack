private theorem b31RowGroup105_other_all (part : Fin 346) :
    b31RowGroup105Blockers part = (b31RowGroup105Blocks (b31RowGroup105OtherSelect part).1).other (b31RowGroup105OtherSelect part).2 := by
  let batch : Fin 11 := ⟨part.val/32,by have h := part.isLt; omega⟩
  let offset : Fin 32 := ⟨part.val%32,Nat.mod_lt _ (by decide)⟩
  have hi : b31RowGroup105OtherBatchIndex batch offset = part := by
    apply Fin.ext
    change (32*(part.val/32)+part.val%32)%346 = part.val
    rw [Nat.div_add_mod,Nat.mod_eq_of_lt part.isLt]
  rw [← hi]
  exact b31RowGroup105_other_batches batch offset

theorem b31_row_group105_coverage_accepted :
    checkIndexedRectangleCoverage b31RowGroup105Blocks b31RowGroup105Group b31RowGroup105Blockers b31RowGroup105OwnerSelect b31RowGroup105OtherSelect = true := by
  simp only [checkIndexedRectangleCoverage,Bool.and_eq_true,decide_eq_true_eq]
  refine ⟨?_,b31RowGroup105_other_all⟩
  intro block part
  let flat : Fin 70 := ⟨block.val*2+part.val,by
    have hb := block.isLt; have hp := part.isLt; omega⟩
  have hb : b31RowGroup105OwnerBlock flat = block := by
    apply Fin.ext
    dsimp [b31RowGroup105OwnerBlock,flat]
    have hp := part.isLt
    omega
  have hp : b31RowGroup105OwnerPart flat = part := by
    apply Fin.ext
    dsimp [b31RowGroup105OwnerPart,flat]
    have hp := part.isLt
    omega
  have h := b31RowGroup105_owner_all flat
  rw [hb,hp] at h
  exact h

