theorem b31_row_group76_coverage_accepted :
    checkIndexedRectangleCoverage b31RowGroup76Blocks b31RowGroup76Group b31RowGroup76Blockers b31RowGroup76OwnerSelect b31RowGroup76OtherSelect = true := by
  simp only [checkIndexedRectangleCoverage,Bool.and_eq_true,decide_eq_true_eq]
  refine ⟨?_,b31RowGroup76_other_all⟩
  intro block part
  let flat : Fin 47 := ⟨block.val*1+part.val,by
    have hb := block.isLt; have hp := part.isLt; omega⟩
  have hb : b31RowGroup76OwnerBlock flat = block := by
    apply Fin.ext
    dsimp [b31RowGroup76OwnerBlock,flat]
    have hp := part.isLt
    omega
  have hp : b31RowGroup76OwnerPart flat = part := by
    apply Fin.ext
    dsimp [b31RowGroup76OwnerPart,flat]
    have hp := part.isLt
    omega
  have h := b31RowGroup76_owner_all flat
  rw [hb,hp] at h
  exact h

