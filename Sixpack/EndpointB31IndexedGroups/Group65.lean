private theorem b31RowGroup65_other_all (part : Fin 346) :
    b31RowGroup65Blockers part = (b31RowGroup65Blocks (b31RowGroup65OtherSelect part).1).other (b31RowGroup65OtherSelect part).2 := by
  let batch : Fin 11 := ⟨part.val/32,by have h := part.isLt; omega⟩
  let offset : Fin 32 := ⟨part.val%32,Nat.mod_lt _ (by decide)⟩
  have hi : b31RowGroup65OtherBatchIndex batch offset = part := by
    apply Fin.ext
    change (32*(part.val/32)+part.val%32)%346 = part.val
    rw [Nat.div_add_mod,Nat.mod_eq_of_lt part.isLt]
  rw [← hi]
  exact b31RowGroup65_other_batches batch offset

theorem b31_row_group65_coverage_accepted :
    checkIndexedRectangleCoverage b31RowGroup65Blocks b31RowGroup65Group b31RowGroup65Blockers b31RowGroup65OwnerSelect b31RowGroup65OtherSelect = true := by
  simp only [checkIndexedRectangleCoverage,Bool.and_eq_true,decide_eq_true_eq]
  refine ⟨?_,b31RowGroup65_other_all⟩
  intro block part
  let flat : Fin 74 := ⟨block.val*2+part.val,by
    have hb := block.isLt; have hp := part.isLt; omega⟩
  have hb : b31RowGroup65OwnerBlock flat = block := by
    apply Fin.ext
    dsimp [b31RowGroup65OwnerBlock,flat]
    have hp := part.isLt
    omega
  have hp : b31RowGroup65OwnerPart flat = part := by
    apply Fin.ext
    dsimp [b31RowGroup65OwnerPart,flat]
    have hp := part.isLt
    omega
  have h := b31RowGroup65_owner_all flat
  rw [hb,hp] at h
  exact h

