  refine ⟨?_,b31RowGroup94_other_all⟩
  intro block part
  let flat : Fin 84 := ⟨block.val*2+part.val,by
    have hb := block.isLt; have hp := part.isLt; omega⟩
  have hb : b31RowGroup94OwnerBlock flat = block := by
    apply Fin.ext
    dsimp [b31RowGroup94OwnerBlock,flat]
    have hp := part.isLt
    omega
  have hp : b31RowGroup94OwnerPart flat = part := by
    apply Fin.ext
    dsimp [b31RowGroup94OwnerPart,flat]
    have hp := part.isLt
    omega
  have h := b31RowGroup94_owner_all flat
  rw [hb,hp] at h
  exact h

