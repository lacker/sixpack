theorem b31_row_group353_coverage_accepted :
    checkIndexedRectangleCoverage b31RowGroup353Blocks b31RowGroup353Group b31RowGroup353Blockers b31RowGroup353OwnerSelect b31RowGroup353OtherSelect = true := by
  simp only [checkIndexedRectangleCoverage,Bool.and_eq_true,decide_eq_true_eq]
  refine ⟨?_,b31RowGroup353_other_all⟩
  intro block part
  let flat : Fin 33 := ⟨block.val*1+part.val,by
    have hb := block.isLt; have hp := part.isLt; omega⟩
  have hb : b31RowGroup353OwnerBlock flat = block := by
    apply Fin.ext
    dsimp [b31RowGroup353OwnerBlock,flat]
    have hp := part.isLt
    omega
  have hp : b31RowGroup353OwnerPart flat = part := by
    apply Fin.ext
    dsimp [b31RowGroup353OwnerPart,flat]
    have hp := part.isLt
    omega
  have h := b31RowGroup353_owner_all flat
  rw [hb,hp] at h
  exact h

