  intro block part
  let flat : Fin 48 := ⟨block.val*1+part.val,by
    have hb := block.isLt; have hp := part.isLt; omega⟩
  have hb : b31RowGroup73OwnerBlock flat = block := by
    apply Fin.ext
    dsimp [b31RowGroup73OwnerBlock,flat]
    have hp := part.isLt
    omega
  have hp : b31RowGroup73OwnerPart flat = part := by
    apply Fin.ext
    dsimp [b31RowGroup73OwnerPart,flat]
    have hp := part.isLt
    omega
  have h := b31RowGroup73_owner_all flat
  rw [hb,hp] at h
  exact h

