  refine ⟨?_,b31RowGroup122_other_all⟩
  intro block part
  let flat : Fin 45 := ⟨block.val*1+part.val,by
    have hb := block.isLt; have hp := part.isLt; omega⟩
  have hb : b31RowGroup122OwnerBlock flat = block := by
    apply Fin.ext
    dsimp [b31RowGroup122OwnerBlock,flat]
    have hp := part.isLt
    omega
  have hp : b31RowGroup122OwnerPart flat = part := by
    apply Fin.ext
    dsimp [b31RowGroup122OwnerPart,flat]
    have hp := part.isLt
    omega
  have h := b31RowGroup122_owner_all flat
  rw [hb,hp] at h
  exact h

