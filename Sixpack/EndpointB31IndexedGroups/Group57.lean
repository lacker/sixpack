theorem b31_row_group57_coverage_accepted :
    checkIndexedRectangleCoverage b31RowGroup57Blocks b31RowGroup57Group b31RowGroup57Blockers b31RowGroup57OwnerSelect b31RowGroup57OtherSelect = true := by
  simp only [checkIndexedRectangleCoverage,Bool.and_eq_true,decide_eq_true_eq]
  refine ⟨?_,b31RowGroup57_other_all⟩
  intro block part
  let flat : Fin 52 := ⟨block.val*1+part.val,by
    have hb := block.isLt; have hp := part.isLt; omega⟩
  have hb : b31RowGroup57OwnerBlock flat = block := by
    apply Fin.ext
    dsimp [b31RowGroup57OwnerBlock,flat]
    have hp := part.isLt
    omega
  have hp : b31RowGroup57OwnerPart flat = part := by
    apply Fin.ext
    dsimp [b31RowGroup57OwnerPart,flat]
    have hp := part.isLt
    omega
  have h := b31RowGroup57_owner_all flat
  rw [hb,hp] at h
  exact h

