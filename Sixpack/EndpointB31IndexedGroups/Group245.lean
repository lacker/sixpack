theorem b31_row_group245_coverage_accepted :
    checkIndexedRectangleCoverage b31RowGroup245Blocks b31RowGroup245Group b31RowGroup245Blockers b31RowGroup245OwnerSelect b31RowGroup245OtherSelect = true := by
  simp only [checkIndexedRectangleCoverage,Bool.and_eq_true,decide_eq_true_eq]
  refine ⟨?_,b31RowGroup245_other_all⟩
  intro block part
  let flat : Fin 88 := ⟨block.val*2+part.val,by
    have hb := block.isLt; have hp := part.isLt; omega⟩
  have hb : b31RowGroup245OwnerBlock flat = block := by
    apply Fin.ext
    dsimp [b31RowGroup245OwnerBlock,flat]
    have hp := part.isLt
    omega
  have hp : b31RowGroup245OwnerPart flat = part := by
    apply Fin.ext
    dsimp [b31RowGroup245OwnerPart,flat]
    have hp := part.isLt
    omega
  have h := b31RowGroup245_owner_all flat
  rw [hb,hp] at h
  exact h

