    checkIndexedRectangleCoverage b31RowGroup309Blocks b31RowGroup309Group b31RowGroup309Blockers b31RowGroup309OwnerSelect b31RowGroup309OtherSelect = true := by
  simp only [checkIndexedRectangleCoverage,Bool.and_eq_true,decide_eq_true_eq]
  refine ⟨?_,b31RowGroup309_other_all⟩
  intro block part
  let flat : Fin 70 := ⟨block.val*1+part.val,by
    have hb := block.isLt; have hp := part.isLt; omega⟩
  have hb : b31RowGroup309OwnerBlock flat = block := by
    apply Fin.ext
    dsimp [b31RowGroup309OwnerBlock,flat]
    have hp := part.isLt
    omega
  have hp : b31RowGroup309OwnerPart flat = part := by
    apply Fin.ext
    dsimp [b31RowGroup309OwnerPart,flat]
    have hp := part.isLt
    omega
  have h := b31RowGroup309_owner_all flat
  rw [hb,hp] at h
  exact h

