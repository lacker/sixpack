  refine ⟨?_,b31RowGroup302_other_all⟩
  intro block part
  let flat : Fin 52 := ⟨block.val*1+part.val,by
    have hb := block.isLt; have hp := part.isLt; omega⟩
  have hb : b31RowGroup302OwnerBlock flat = block := by
    apply Fin.ext
    dsimp [b31RowGroup302OwnerBlock,flat]
    have hp := part.isLt
    omega
  have hp : b31RowGroup302OwnerPart flat = part := by
    apply Fin.ext
    dsimp [b31RowGroup302OwnerPart,flat]
    have hp := part.isLt
    omega
  have h := b31RowGroup302_owner_all flat
  rw [hb,hp] at h
  exact h

