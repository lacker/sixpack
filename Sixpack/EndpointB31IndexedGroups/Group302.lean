theorem b31_row_group302_coverage_accepted :
    checkIndexedRectangleCoverage b31RowGroup302Blocks b31RowGroup302Group b31RowGroup302Blockers b31RowGroup302OwnerSelect b31RowGroup302OtherSelect = true := by
