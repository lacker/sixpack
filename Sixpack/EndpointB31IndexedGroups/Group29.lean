theorem b31_row_group29_coverage_accepted :
    checkIndexedRectangleCoverage b31RowGroup29Blocks b31RowGroup29Group b31RowGroup29Blockers b31RowGroup29OwnerSelect b31RowGroup29OtherSelect = true := by
  simp only [checkIndexedRectangleCoverage,Bool.and_eq_true,decide_eq_true_eq]
  refine ⟨?_,b31RowGroup29_other_all⟩
  intro block part
  let flat : Fin 88 := ⟨block.val*2+part.val,by
    have hb := block.isLt; have hp := part.isLt; omega⟩
  have hb : b31RowGroup29OwnerBlock flat = block := by
    apply Fin.ext
    dsimp [b31RowGroup29OwnerBlock,flat]
    have hp := part.isLt
    omega
  have hp : b31RowGroup29OwnerPart flat = part := by
    apply Fin.ext
    dsimp [b31RowGroup29OwnerPart,flat]
    have hp := part.isLt
    omega
  have h := b31RowGroup29_owner_all flat
  rw [hb,hp] at h
  exact h

