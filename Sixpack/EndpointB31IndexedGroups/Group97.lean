    checkIndexedRectangleCoverage b31RowGroup97Blocks b31RowGroup97Group b31RowGroup97Blockers b31RowGroup97OwnerSelect b31RowGroup97OtherSelect = true := by
  simp only [checkIndexedRectangleCoverage,Bool.and_eq_true,decide_eq_true_eq]
  refine ⟨?_,b31RowGroup97_other_all⟩
  intro block part
  let flat : Fin 46 := ⟨block.val*1+part.val,by
    have hb := block.isLt; have hp := part.isLt; omega⟩
  have hb : b31RowGroup97OwnerBlock flat = block := by
    apply Fin.ext
    dsimp [b31RowGroup97OwnerBlock,flat]
    have hp := part.isLt
    omega
  have hp : b31RowGroup97OwnerPart flat = part := by
    apply Fin.ext
    dsimp [b31RowGroup97OwnerPart,flat]
    have hp := part.isLt
    omega
  have h := b31RowGroup97_owner_all flat
  rw [hb,hp] at h
  exact h

