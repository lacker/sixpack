private theorem b31RowGroup85_other_all (part : Fin 346) :
    b31RowGroup85Blockers part = (b31RowGroup85Blocks (b31RowGroup85OtherSelect part).1).other (b31RowGroup85OtherSelect part).2 := by
  let batch : Fin 11 := ⟨part.val/32,by have h := part.isLt; omega⟩
  let offset : Fin 32 := ⟨part.val%32,Nat.mod_lt _ (by decide)⟩
  have hi : b31RowGroup85OtherBatchIndex batch offset = part := by
    apply Fin.ext
    change (32*(part.val/32)+part.val%32)%346 = part.val
    rw [Nat.div_add_mod,Nat.mod_eq_of_lt part.isLt]
  rw [← hi]
  exact b31RowGroup85_other_batches batch offset

theorem b31_row_group85_coverage_accepted :
    checkIndexedRectangleCoverage b31RowGroup85Blocks b31RowGroup85Group b31RowGroup85Blockers b31RowGroup85OwnerSelect b31RowGroup85OtherSelect = true := by
  simp only [checkIndexedRectangleCoverage,Bool.and_eq_true,decide_eq_true_eq]
  refine ⟨?_,b31RowGroup85_other_all⟩
  intro block part
  let flat : Fin 68 := ⟨block.val*2+part.val,by
    have hb := block.isLt; have hp := part.isLt; omega⟩
  have hb : b31RowGroup85OwnerBlock flat = block := by
    apply Fin.ext
    dsimp [b31RowGroup85OwnerBlock,flat]
    have hp := part.isLt
    omega
  have hp : b31RowGroup85OwnerPart flat = part := by
    apply Fin.ext
    dsimp [b31RowGroup85OwnerPart,flat]
    have hp := part.isLt
    omega
  have h := b31RowGroup85_owner_all flat
  rw [hb,hp] at h
  exact h

