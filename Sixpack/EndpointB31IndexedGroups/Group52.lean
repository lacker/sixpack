theorem b31_row_group52_coverage_accepted :
    checkIndexedRectangleCoverage b31RowGroup52Blocks b31RowGroup52Group b31RowGroup52Blockers b31RowGroup52OwnerSelect b31RowGroup52OtherSelect = true := by
  simp only [checkIndexedRectangleCoverage,Bool.and_eq_true,decide_eq_true_eq]
  refine ⟨?_,b31RowGroup52_other_all⟩
  intro block part
  let flat : Fin 57 := ⟨block.val*1+part.val,by
    have hb := block.isLt; have hp := part.isLt; omega⟩
  have hb : b31RowGroup52OwnerBlock flat = block := by
    apply Fin.ext
    dsimp [b31RowGroup52OwnerBlock,flat]
    have hp := part.isLt
    omega
  have hp : b31RowGroup52OwnerPart flat = part := by
    apply Fin.ext
    dsimp [b31RowGroup52OwnerPart,flat]
    have hp := part.isLt
    omega
  have h := b31RowGroup52_owner_all flat
  rw [hb,hp] at h
  exact h

