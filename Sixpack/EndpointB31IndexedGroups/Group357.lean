  refine ⟨?_,b31RowGroup357_other_all⟩
  intro block part
  let flat : Fin 34 := ⟨block.val*1+part.val,by
    have hb := block.isLt; have hp := part.isLt; omega⟩
  have hb : b31RowGroup357OwnerBlock flat = block := by
    apply Fin.ext
    dsimp [b31RowGroup357OwnerBlock,flat]
    have hp := part.isLt
    omega
  have hp : b31RowGroup357OwnerPart flat = part := by
    apply Fin.ext
