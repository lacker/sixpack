def b31RefinementChildSlot (parent : Fin 969) (child : Fin 4) (right : Bool) : ℕ :=
  b31RefinementSlot (8*parent.val+2*child.val+(if right then 1 else 0))

def b31RefinementChildBound (component : Fin 6) (parent : Fin 969)
    (child : Fin 4) (right : Bool) : Prop :=
  match b31Witnesses parent child right with
  | .retained node => node = b31RefinementInitialEntry component
      (b31RefinementChildSlot parent child right)
  | .empty _ => True

instance (component : Fin 6) (parent : Fin 969) (child : Fin 4) (right : Bool) :
    Decidable (b31RefinementChildBound component parent child right) := by
  unfold b31RefinementChildBound
  split <;> infer_instance

theorem b31_refinement_initial_entry_mem (component : Fin 6) (slot : ℕ) :
    b31RefinementInitialEntry component slot ∈ b31SnapshotDomains 0 component := by
  fin_cases component
  · change b31Partition0Old ⟨slot%872,Nat.mod_lt _ (by decide)⟩ ∈
      Finset.univ.image b31Partition0Old
    exact Finset.mem_image.mpr ⟨_,Finset.mem_univ _,rfl⟩
  · change b31Partition2Old ⟨slot%346,Nat.mod_lt _ (by decide)⟩ ∈
      Finset.univ.image b31Partition2Old
    exact Finset.mem_image.mpr ⟨_,Finset.mem_univ _,rfl⟩
  · change b31Partition5Old ⟨slot%618,Nat.mod_lt _ (by decide)⟩ ∈
      Finset.univ.image b31Partition5Old
    exact Finset.mem_image.mpr ⟨_,Finset.mem_univ _,rfl⟩
  · change b31Partition9Old ⟨slot%714,Nat.mod_lt _ (by decide)⟩ ∈
      Finset.univ.image b31Partition9Old
    exact Finset.mem_image.mpr ⟨_,Finset.mem_univ _,rfl⟩
  · change b31Partition11Old ⟨slot%24,Nat.mod_lt _ (by decide)⟩ ∈
      Finset.univ.image b31Partition11Old
    exact Finset.mem_image.mpr ⟨_,Finset.mem_univ _,rfl⟩
