set_option maxHeartbeats 0 in
theorem first_order_branch_seven_geometry : ∀ j k,
    firstOrderBranchSeven.A j k = exactGradient (firstOrderBranchSevenLabels j) k :=
  by decide +kernel

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
theorem first_order_branch_seven_active : ∀ j,
    exactConstraintValue (firstOrderBranchSevenLabels j) = Quadratic13.zero :=
  by decide +kernel

theorem first_order_branch_seven_basepoint (d : LocalCoordinate → ℝ) (j : Fin 15) :
    localConstraintPath (firstOrderBranchSevenLabels j) d 0 = 0 := by
  rw [localConstraintPath_zero, first_order_branch_seven_active, Quadratic13.value_zero]

theorem first_order_branch_seven_slacks (d : LocalCoordinate → ℝ) (j : Fin 15) :
    linearSlacks firstOrderBranchSeven d j =
      constraintVelocity (firstOrderBranchSevenLabels j) d := by
  simp only [linearSlacks]
  simp_rw [first_order_branch_seven_geometry]
  exact exactGradient_velocity _ _

theorem first_order_branch_seven_derivative (d : LocalCoordinate → ℝ) (j : Fin 15) :
    HasDerivAt (localConstraintPath (firstOrderBranchSevenLabels j) d)
      (linearSlacks firstOrderBranchSeven d j) 0 := by
  rw [first_order_branch_seven_slacks]
  exact localConstraintPath_derivative _ _

/-- The actual branch-7 first-order constraints force zero slacks and the
certified pivot motion. This is infinitesimal, not nonlinear rigidity. -/
theorem first_order_branch_seven_motion (d : LocalCoordinate → ℝ)
    (hfeasible : ∀ j, 0 ≤ constraintVelocity (firstOrderBranchSevenLabels j) d)
    (hcost : d 15 ≤ 0) :
    (∀ j, constraintVelocity (firstOrderBranchSevenLabels j) d = 0) ∧
    (∀ i, d i = d 8 * (firstOrderBranchSeven.kernel i).value) := by
  have h := checked_linear_motion firstOrderBranchSeven first_order_branch_seven_accepts d
    (by simpa only [first_order_branch_seven_slacks] using hfeasible) hcost
  simpa only [first_order_branch_seven_slacks] using h



