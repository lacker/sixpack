set_option maxHeartbeats 0 in
theorem first_order_branch_zero_accepts :
    checkExactLinear firstOrderBranchZero = true := by decide +kernel

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
theorem first_order_branch_zero_geometry : ∀ j k,
    firstOrderBranchZero.A j k = exactGradient (firstOrderBranchZeroLabels j) k :=
  by decide +kernel

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
theorem first_order_branch_zero_active : ∀ j,
    exactConstraintValue (firstOrderBranchZeroLabels j) = Quadratic13.zero :=
  by decide +kernel

theorem first_order_branch_zero_basepoint (d : LocalCoordinate → ℝ) (j : Fin 15) :
    localConstraintPath (firstOrderBranchZeroLabels j) d 0 = 0 := by
  rw [localConstraintPath_zero, first_order_branch_zero_active, Quadratic13.value_zero]

theorem first_order_branch_zero_slacks (d : LocalCoordinate → ℝ) (j : Fin 15) :
    linearSlacks firstOrderBranchZero d j =
      constraintVelocity (firstOrderBranchZeroLabels j) d := by
  simp only [linearSlacks]
  simp_rw [first_order_branch_zero_geometry]
  exact exactGradient_velocity _ _

theorem first_order_branch_zero_derivative (d : LocalCoordinate → ℝ) (j : Fin 15) :
    HasDerivAt (localConstraintPath (firstOrderBranchZeroLabels j) d)
      (linearSlacks firstOrderBranchZero d j) 0 := by
  rw [first_order_branch_zero_slacks]
  exact localConstraintPath_derivative _ _

/-- The actual branch-0 first-order constraints force zero slacks and the
certified pivot motion. This is infinitesimal, not nonlinear rigidity. -/
theorem first_order_branch_zero_motion (d : LocalCoordinate → ℝ)
    (hfeasible : ∀ j, 0 ≤ constraintVelocity (firstOrderBranchZeroLabels j) d)
    (hcost : d 15 ≤ 0) :
    (∀ j, constraintVelocity (firstOrderBranchZeroLabels j) d = 0) ∧
    (∀ i, d i = d 8 * (firstOrderBranchZero.kernel i).value) := by
  have h := checked_linear_motion firstOrderBranchZero first_order_branch_zero_accepts d
    (by simpa only [first_order_branch_zero_slacks] using hfeasible) hcost
  simpa only [first_order_branch_zero_slacks] using h


