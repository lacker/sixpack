/-- Saved root tags factored by their fine cell. Unretained cells are filled
with untrusted ancestry tags and are checked by the same universal theorem. -/
def rootCoarseTag (c : GridCell 32) : Fin 16 :=
  let row := match c.val.1.val with
    | 0 => rootCoarseTagsRow0
    | 1 => rootCoarseTagsRow1
    | 2 => rootCoarseTagsRow2
    | 3 => rootCoarseTagsRow3
    | 4 => rootCoarseTagsRow4
    | 5 => rootCoarseTagsRow5
    | 6 => rootCoarseTagsRow6
    | 7 => rootCoarseTagsRow7
    | 8 => rootCoarseTagsRow8
    | 9 => rootCoarseTagsRow9
    | 10 => rootCoarseTagsRow10
    | 11 => rootCoarseTagsRow11
    | 12 => rootCoarseTagsRow12
    | 13 => rootCoarseTagsRow13
    | 14 => rootCoarseTagsRow14
    | 15 => rootCoarseTagsRow15
    | 16 => rootCoarseTagsRow16
    | 17 => rootCoarseTagsRow17
    | 18 => rootCoarseTagsRow18
    | 19 => rootCoarseTagsRow19
    | 20 => rootCoarseTagsRow20
    | 21 => rootCoarseTagsRow21
    | 22 => rootCoarseTagsRow22
    | 23 => rootCoarseTagsRow23
    | 24 => rootCoarseTagsRow24
    | 25 => rootCoarseTagsRow25
    | 26 => rootCoarseTagsRow26
    | 27 => rootCoarseTagsRow27
    | 28 => rootCoarseTagsRow28
    | 29 => rootCoarseTagsRow29
    | 30 => rootCoarseTagsRow30
    | _ => rootCoarseTagsRow31
  row.getD (2*c.val.2.1.val + if c.val.2.2 then 1 else 0) 0

end Sixpack
