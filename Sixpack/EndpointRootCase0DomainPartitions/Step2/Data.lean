  | 11 => rootCase0Partition2WitnessNodePage11.getD (index%32) (.inl 0)
  | 12 => rootCase0Partition2WitnessNodePage12.getD (index%32) (.inl 0)
  | 13 => rootCase0Partition2WitnessNodePage13.getD (index%32) (.inl 0)
  | 14 => rootCase0Partition2WitnessNodePage14.getD (index%32) (.inl 0)
  | 15 => rootCase0Partition2WitnessNodePage15.getD (index%32) (.inl 0)
  | 16 => rootCase0Partition2WitnessNodePage16.getD (index%32) (.inl 0)
  | _ => .inl 0

def rootCase0Partition2WitnessNode (index : ℕ) : Sum (Fin 14) (Fin 508) :=
  match index/1024 with
  | 0 => rootCase0Partition2WitnessNodeGroup0 index
  | _ => .inl 0

def rootCase0Partition2Witness (part : Fin 522) : Sum (Fin 14) (Fin 508) :=
  rootCase0Partition2WitnessNode part.val

def rootCase0Partition2BatchIndex (batch : Fin 17) (offset : Fin 32) : Fin 522 :=
  ⟨(32*batch.val+offset.val)%522,Nat.mod_lt _ (by decide)⟩

