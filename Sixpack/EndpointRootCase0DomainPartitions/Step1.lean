theorem root_case0_partition1_accepted :
    checkIndexedDomainPartition rootCase0Partition1Old rootCase0Partition1Kept rootCase0Partition1Removed
      rootCase0Partition1Witness = true := by
  simp only [checkIndexedDomainPartition,decide_eq_true_eq]
  intro part
  let batch : Fin 80 := ⟨part.val/32,by have h := part.isLt; omega⟩
  let offset : Fin 32 := ⟨part.val%32,Nat.mod_lt _ (by decide)⟩
  have hi : rootCase0Partition1BatchIndex batch offset = part := by
    apply Fin.ext
    change (32*(part.val/32)+part.val%32)%2556 = part.val
    rw [Nat.div_add_mod,Nat.mod_eq_of_lt part.isLt]
  rw [← hi]
  exact root_case0_partition1_batches batch offset

theorem root_case0_partition1_survivors :
    (Finset.univ.image rootCase0Partition1Old) \ (Finset.univ.image rootCase0Partition1Removed) ⊆
      Finset.univ.image rootCase0Partition1Kept :=
  checked_indexed_domain_partition_survivors _ _ _ _ root_case0_partition1_accepted

end Sixpack
