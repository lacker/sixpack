def b31GeometricStep0BlockerCheckIndex (batch : Fin 11) (offset : Fin 32) : Fin 346 :=
  ⟨(32*batch.val+offset.val)%346,Nat.mod_lt _ (by decide)⟩

private theorem b31_geometric_step0_blocker_entries_batch0 (offset : Fin 32) :
    b31RowGroup0Blockers (b31GeometricStep0BlockerCheckIndex 0 offset) = b31Step0Blockers (b31GeometricStep0BlockerCheckIndex 0 offset) := by
  fin_cases offset <;> decide +kernel

private theorem b31_geometric_step0_blocker_entries_batch1 (offset : Fin 32) :
    b31RowGroup0Blockers (b31GeometricStep0BlockerCheckIndex 1 offset) = b31Step0Blockers (b31GeometricStep0BlockerCheckIndex 1 offset) := by
  fin_cases offset <;> decide +kernel

