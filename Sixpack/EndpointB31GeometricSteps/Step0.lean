private theorem b31_geometric_step0_blocker_entries_batches (batch : Fin 11) (offset : Fin 32) :
    b31RowGroup0Blockers (b31GeometricStep0BlockerCheckIndex batch offset) = b31Step0Blockers (b31GeometricStep0BlockerCheckIndex batch offset) := by
  fin_cases batch
  · exact b31_geometric_step0_blocker_entries_batch0 offset
  · exact b31_geometric_step0_blocker_entries_batch1 offset
  · exact b31_geometric_step0_blocker_entries_batch2 offset
  · exact b31_geometric_step0_blocker_entries_batch3 offset
  · exact b31_geometric_step0_blocker_entries_batch4 offset
  · exact b31_geometric_step0_blocker_entries_batch5 offset
  · exact b31_geometric_step0_blocker_entries_batch6 offset
  · exact b31_geometric_step0_blocker_entries_batch7 offset
  · exact b31_geometric_step0_blocker_entries_batch8 offset
  · exact b31_geometric_step0_blocker_entries_batch9 offset
  · exact b31_geometric_step0_blocker_entries_batch10 offset

theorem b31_geometric_step0_blocker_entries (part : Fin 346) :
    b31RowGroup0Blockers part = b31Step0Blockers part := by
  let batch : Fin 11 := ⟨part.val/32,by have h := part.isLt; omega⟩
  let offset : Fin 32 := ⟨part.val%32,Nat.mod_lt _ (by decide)⟩
  have hi : b31GeometricStep0BlockerCheckIndex batch offset = part := by
    apply Fin.ext
    change (32*(part.val/32)+part.val%32)%346 = part.val
    rw [Nat.div_add_mod,Nat.mod_eq_of_lt part.isLt]
  rw [← hi]
  exact b31_geometric_step0_blocker_entries_batches batch offset

theorem b31_geometric_step0_blocker_function :
    b31RowGroup0Blockers = b31Step0Blockers := by
  funext part
  exact b31_geometric_step0_blocker_entries part

