    b31RowGroup0Blockers (b31GeometricStep0BlockerCheckIndex 6 offset) = b31Step0Blockers (b31GeometricStep0BlockerCheckIndex 6 offset) := by
  fin_cases offset <;> decide +kernel

private theorem b31_geometric_step0_blocker_entries_batch7 (offset : Fin 32) :
    b31RowGroup0Blockers (b31GeometricStep0BlockerCheckIndex 7 offset) = b31Step0Blockers (b31GeometricStep0BlockerCheckIndex 7 offset) := by
