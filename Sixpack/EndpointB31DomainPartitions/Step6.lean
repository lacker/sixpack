theorem b31_partition6_accepted :
    checkIndexedDomainPartition b31Partition6Old b31Partition6Kept b31Partition6Removed
      b31Partition6Witness = true := by
  simp only [checkIndexedDomainPartition,decide_eq_true_eq]
  intro part
  let batch : Fin 19 := ⟨part.val/32,by have h := part.isLt; omega⟩
  let offset : Fin 32 := ⟨part.val%32,Nat.mod_lt _ (by decide)⟩
  have hi : b31Partition6BatchIndex batch offset = part := by
    apply Fin.ext
    change (32*(part.val/32)+part.val%32)%592 = part.val
    rw [Nat.div_add_mod,Nat.mod_eq_of_lt part.isLt]
  rw [← hi]
  exact b31_partition6_batches batch offset

theorem b31_partition6_survivors :
    (Finset.univ.image b31Partition6Old) \ (Finset.univ.image b31Partition6Removed) ⊆
      Finset.univ.image b31Partition6Kept :=
  checked_indexed_domain_partition_survivors _ _ _ _ b31_partition6_accepted

