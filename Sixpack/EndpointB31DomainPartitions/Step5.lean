def b31Partition5Witness (part : Fin 618) : Sum (Fin 592) (Fin 26) :=
  b31Partition5WitnessNode part.val

def b31Partition5BatchIndex (batch : Fin 20) (offset : Fin 32) : Fin 618 :=
  ⟨(32*batch.val+offset.val)%618,Nat.mod_lt _ (by decide)⟩

