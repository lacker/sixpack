  let batch : Fin 28 := ⟨part.val/32,by have h := part.isLt; omega⟩
  let offset : Fin 32 := ⟨part.val%32,Nat.mod_lt _ (by decide)⟩
  have hi : b31Partition0BatchIndex batch offset = part := by
    apply Fin.ext
    change (32*(part.val/32)+part.val%32)%872 = part.val
    rw [Nat.div_add_mod,Nat.mod_eq_of_lt part.isLt]
  rw [← hi]
  exact b31_partition0_batches batch offset

theorem b31_partition0_survivors :
    (Finset.univ.image b31Partition0Old) \ (Finset.univ.image b31Partition0Removed) ⊆
      Finset.univ.image b31Partition0Kept :=
  checked_indexed_domain_partition_survivors _ _ _ _ b31_partition0_accepted

end Sixpack
