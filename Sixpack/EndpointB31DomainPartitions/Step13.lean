theorem b31_partition13_accepted :
    checkIndexedDomainPartition b31Partition13Old b31Partition13Kept b31Partition13Removed
      b31Partition13Witness = true := by
  simp only [checkIndexedDomainPartition,decide_eq_true_eq]
  intro part
  let batch : Fin 54 := ⟨part.val/32,by have h := part.isLt; omega⟩
  let offset : Fin 32 := ⟨part.val%32,Nat.mod_lt _ (by decide)⟩
  have hi : b31Partition13BatchIndex batch offset = part := by
    apply Fin.ext
    change (32*(part.val/32)+part.val%32)%1709 = part.val
    rw [Nat.div_add_mod,Nat.mod_eq_of_lt part.isLt]
  rw [← hi]
  exact b31_partition13_batches batch offset

theorem b31_partition13_survivors :
    (Finset.univ.image b31Partition13Old) \ (Finset.univ.image b31Partition13Removed) ⊆
      Finset.univ.image b31Partition13Kept :=
  checked_indexed_domain_partition_survivors _ _ _ _ b31_partition13_accepted

